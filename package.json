{
  "name": "aisle-price-intelligence",
  "version": "0.1.0",
  "private": true,
  "description": "Aisle — premium Amazon price intelligence: variant-aware monitoring, normalized unit pricing, competitive comparisons.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx --conditions=react-server worker/index.ts",
    "worker:dev": "tsx watch --conditions=react-server worker/index.ts",
    "worker:once": "tsx --conditions=react-server worker/run-once.ts",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server scripts/migrate.ts",
    "db:seed": "tsx --conditions=react-server scripts/seed.ts",
    "db:reset": "tsx --conditions=react-server scripts/reset.ts",
    "setup": "pnpm db:migrate && pnpm db:seed"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@tanstack/react-query": "5.104.2",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.15",
    "better-auth": "1.7.7",
    "bullmq": "5.81.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "drizzle-orm": "0.45.4",
    "exceljs": "4.4.0",
    "geist": "1.7.2",
    "ioredis": "5.11.1",
    "lucide-react": "1.55.0",
    "motion": "12.43.0",
    "next": "16.4.0",
    "pdfkit": "0.20.2",
    "pino": "^10.4.0",
    "postgres": "3.4.9",
    "radix-ui": "1.8.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "server-only": "^0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.5",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "dotenv": "^18.0.7",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "jsdom": "26.1.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
