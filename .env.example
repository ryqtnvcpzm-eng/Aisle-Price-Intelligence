# ─────────────────────────────────────────────────────────────────────────────
# Aisle — environment configuration. Copy to `.env` and fill in what you need.
# Blank values are treated as unset. Never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL 14+ (local: docker compose up -d). Neon / Supabase / Railway URLs work too.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/aisle

# Redis (optional). With it: a long-running BullMQ worker (`pnpm worker`).
# Without it: caching uses Postgres and you schedule `pnpm worker:once` hourly.
REDIS_URL=redis://localhost:6379

# Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# The public URL of the web app (used for cookies and links in emails).
BETTER_AUTH_URL=http://localhost:3000

# ── Data providers (free only) ───────────────────────────────────────────────
# auto = Amazon Creators API if configured, else demo mode (simulated, labelled).
DATA_PROVIDER=auto

# Amazon Creators API — free with an approved Amazon Associates account
# (https://affiliate-program.amazon.com). Lookup-only unless you set LICENSE_ACK=true
# after confirming your Associates agreement permits storing/monitoring prices.
CREATORS_API_CREDENTIAL_ID=
CREATORS_API_CREDENTIAL_SECRET=
CREATORS_API_CREDENTIAL_VERSION=
CREATORS_API_PARTNER_TAG=
CREATORS_API_LICENSE_ACK=false

# ── Monitoring ───────────────────────────────────────────────────────────────
MONITOR_DEFAULT_INTERVAL_MINUTES=60
MONITOR_MAX_ASINS_PER_TICK=500
MONITOR_CONCURRENCY=2
# Delete observations older than this (set to what your provider licence allows).
OBSERVATION_RETENTION_DAYS=730
ALLOW_SHORT_LINK_RESOLUTION=true

# ── Optional integrations ────────────────────────────────────────────────────
# Transactional email for alerts/digests (https://resend.com). In-app works without it.
RESEND_API_KEY=
EMAIL_FROM=Aisle <alerts@example.com>
# "true" records emails as not sent instead of sending them (previews, staging).
EMAIL_DRY_RUN=
# Optional "Brief me" summaries on the Insights page. Off unless a key is set.
# Needs an Anthropic API key (console.anthropic.com) — API usage is billed
# separately from Claude chat subscriptions, so leave blank to stay free.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Who may create an account. Comma-separated emails and/or @domains, e.g.
# "you@gmail.com,@yourcompany.com". Leave blank for open registration — on a
# public URL, set this so strangers can't create accounts or use your provider quota.
SIGNUP_ALLOWLIST=
# Show "Explore the demo workspace" on the sign-in page (seed with `pnpm db:seed`).
# The demo login is public by design — anyone with the URL can use that workspace.
DEMO_ACCOUNT_ENABLED=true
LOG_LEVEL=info
